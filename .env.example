# Every variable here is read somewhere in the code. Nothing here is decorative, and
# nothing the code reads is missing — `grep -rhoE 'process\.env\.[A-Z_0-9]+'` over
# apps/web/src, packages/sdk/src and tools is the check.

# ---------------------------------------------------------------- contracts
# Deploy with:
#   cd packages/contracts
#   PRIVATE_KEY=0x... AUSD=0x... KURU_MON_AUSD=0x... \
#     forge script script/Deploy.s.sol:Deploy --rpc-url $MONAD_RPC_URL --broadcast
PRIVATE_KEY=
MONAD_RPC_URL=https://rpc.monad.xyz
MONAD_TESTNET_RPC_URL=https://rpc.testnet.monad.xyz

# The fallback source behind OracleRouter: keeper | chainlink | pyth.
# There is no mock path — nothing named "mock" is deployable.
ORACLE_KIND=keeper

# Address allowed to push prices to KeeperOracle. Defaults to the deployer.
KEEPER=

# Agora AUSD on Monad mainnet (6 decimals). Leave unset to deploy the test token.
# Verify against https://github.com/monad-crypto/token-list before spending real money.
AUSD=0x00000000eFE302BEAA2b3e6e1b18d08D69a9012a

# Kuru's MON-AUSD order book. REQUIRED for the order-book integration: without it the
# deploy skips KuruOracle entirely and the MON market is silently absent.
KURU_MON_AUSD=0x131a2e70a5b31a517a74b8c567149bc294470da9

# Chainlink price feed proxies. Take these from the live Chainlink address page for
# Monad at deploy time — they are deliberately NOT hardcoded in the contracts.
CHAINLINK_BTC_USD=
CHAINLINK_ETH_USD=
CHAINLINK_MON_USD=

# Pyth (testnet deployment carries MON/USD per docs.monad.xyz/tooling-and-infra/oracles)
PYTH=0x2880aB155794e7179c9eE2e38200202908C17B43
PYTH_BTC_USD=
PYTH_ETH_USD=
PYTH_MON_USD=

# Starting bankroll in AUSD units (6 dp). Test token only.
SEED_VAULT=2000000000

# ------------------------------------------------------------------- keeper
# tools/keeper.mjs. RPC_URL is the node it publishes to; TICK_MS is the push cadence.
RPC_URL=http://127.0.0.1:8545
TICK_MS=1500
# How often to re-mark volatility on-chain, in ms. 0 disables re-marking.
REMARK_MS=900000

# ---------------------------------------------------------------------- web
NEXT_PUBLIC_CHAIN_ID=143
NEXT_PUBLIC_RPC_URL=/api/rpc
# A second public node the client falls back to when the proxy is unreachable.
NEXT_PUBLIC_RPC_FALLBACK=
# What /api/rpc forwards to. Never exposed to the browser.
RPC_UPSTREAM=https://rpc.monad.xyz

NEXT_PUBLIC_AUSD=
NEXT_PUBLIC_ORACLE=
NEXT_PUBLIC_VAULT=
NEXT_PUBLIC_RANGE_MARKET=
NEXT_PUBLIC_ROOM_MARKET=
NEXT_PUBLIC_KURU_ORACLE=
NEXT_PUBLIC_KURU_BOOK=
# Block the contracts were deployed at, so the leaderboard does not scan from genesis.
NEXT_PUBLIC_DEPLOY_BLOCK=
# How many blocks back the leaderboard aggregates settlement events.
LEADERBOARD_LOOKBACK=

# Development only. Opens eth_sendTransaction and account-unlock methods through the
# RPC proxy so an anvil unlocked account can be driven from the browser. MUST be unset
# in any deployment reachable from the internet.
XORR_ALLOW_UNLOCKED_ACCOUNTS=

# ------------------------------------------------------- checks and calibration
# Overrides for tools/checks and the calibration, not deployment config.
# Which node the verification scripts read.
CHAIN_ID=143
# Where in the recent distribution of realised win rates the quoted table sits.
# Default 0.65. Lower is a better price for the player and thinner cover for the vault.
ENVELOPE_PERCENTILE=
# Replay a single tape window in check:edge instead of sweeping four. Debugging only.
REPLAY_OFFSET=
